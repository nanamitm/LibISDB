<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <IntDir>$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
    <OutDir>$(SolutionDir)$(Platform)\$(Configuration)\</OutDir>
    <GenerateManifest>false</GenerateManifest>
    <!-- Static FFmpeg libraries, one set per MSVC runtime (see Thirdparty\ffmpeg\NOTICE.txt) -->
    <LibISDBFFmpegLibDir Condition="'$(Configuration)'=='Debug'">$(MSBuildThisFileDirectory)..\Thirdparty\ffmpeg\lib\MTd\</LibISDBFFmpegLibDir>
    <LibISDBFFmpegLibDir Condition="'$(Configuration)'=='Release'">$(MSBuildThisFileDirectory)..\Thirdparty\ffmpeg\lib\MT\</LibISDBFFmpegLibDir>
    <LibISDBFFmpegLibDir Condition="'$(Configuration)'=='Release_MD'">$(MSBuildThisFileDirectory)..\Thirdparty\ffmpeg\lib\MD\</LibISDBFFmpegLibDir>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(VisualStudioVersion)'=='16.0'">
    <PlatformToolset>v142</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(VisualStudioVersion)'=='17.0'">
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(VisualStudioVersion)'=='18.0'">
    <PlatformToolset>v145</PlatformToolset>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <StringPooling>true</StringPooling>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <MinimalRebuild>false</MinimalRebuild>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
